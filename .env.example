# ContainerYard environment. Validated at startup by server/src/config/env.ts.
# Copy to .env and fill in. Never commit the real .env.

# ---------- Required ----------

# Session signing secret, at least 32 characters:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Redis for sessions
REDIS_URL=redis://127.0.0.1:6379

# Origins allowed to make credentialed CORS requests (comma-separated)
ALLOWED_ORIGINS=https://containeryard.example.com

# Database: SQLite (absolute path recommended) or PostgreSQL.
# SQLite supports users, audit log, bookmarks, saved searches; alerts and
# historical metrics need PostgreSQL.
DATABASE_URL=file:/home/youruser/ContainerYard/server/prisma/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/containeryard

# cAdvisor base URLs for the read-only remote hosts (see server/src/config/hosts.ts)
PIAPPS2_CADVISOR_URL=https://cadvisor.example.com/piapps2/
SYNOLOGY_CADVISOR_URL=https://cadvisor.example.com/synology/

# First ADMIN user, created by: node server/prisma/seed.js  (password >= 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---------- Optional ----------

PORT=5008
NODE_ENV=production
# COOKIE_NAME=__Secure-cy.sid
# COOKIE_DOMAIN=
# lax is recommended when UI and API share an origin (default: none)
COOKIE_SAMESITE=lax

# Dozzle links shown for the remote hosts
# PIAPPS2_DOZZLE_URL=
# SYNOLOGY_DOZZLE_URL=

# Bearer token for the Prometheus /metrics endpoint
# METRICS_TOKEN=

# API base returned by /api/runtime-config (default: derived from the request)
# PUBLIC_API_BASE=https://containeryard.example.com

# Alert webhook SSRF policy. Link-local/metadata targets are always blocked.
WEBHOOK_ALLOW_PRIVATE=false
# Hostnames allowed regardless of the IP they resolve to (e.g. ntfy.lan)
WEBHOOK_ALLOWED_HOSTS=

# Audit log retention in days
AUDIT_RETENTION_DAYS=180

# Host Logs page: which host's local files to read, and where pm2 writes logs
# HOSTLOGS_LOCAL_HOST=piapps
# PM2_APP_NAME=containeryard-api
# PM2_LOG_DIR=/home/youruser/.pm2/logs
