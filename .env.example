# ContainerYard environment. Validated at startup by server/src/config/env.ts.
# Copy to .env and fill in. Never commit the real .env.

# ---------- Required ----------

# Session signing secret, at least 32 characters:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Redis password (used by docker-compose.yml for the bundled redis container)
# Generate with:  openssl rand -hex 24
REDIS_PASSWORD=change-me-redis-password

# Redis URL for sessions (in docker-compose.yml, this is overridden to connect
# to the bundled redis container; for bare-metal/PM2, point at local Redis)
REDIS_URL=redis://127.0.0.1:6379

# Origins allowed to make credentialed CORS requests (comma-separated)
ALLOWED_ORIGINS=https://containeryard.example.com

# Database: SQLite (absolute path recommended) or PostgreSQL.
# In Docker Compose, this is automatically set to file:/data/app.db.
# SQLite supports users, audit log, bookmarks, saved searches; alerts and
# historical metrics need PostgreSQL.
DATABASE_URL=file:/data/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/containeryard

# cAdvisor base URLs for the read-only remote hosts (see server/src/config/hosts.ts)
PIAPPS2_CADVISOR_URL=https://cadvisor.example.com/piapps2/
SYNOLOGY_CADVISOR_URL=https://cadvisor.example.com/synology/
# Optional extra host (listed only when set), e.g. a NAS reached over WireGuard
# DS718_CADVISOR_URL=http://10.0.0.4:9819

# First ADMIN user, created on first boot if the User table is empty (password >= 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---------- Optional (Server Runtime) ----------

PORT=5008
NODE_ENV=production
LOG_LEVEL=info
# DOCKER_HOST=unix:///var/run/docker.sock

# Session cookie settings
# COOKIE_NAME=__Secure-cy.sid
# COOKIE_DOMAIN=
# lax is recommended when UI and API share an origin (default: none)
COOKIE_SAMESITE=lax

# Dozzle links shown for the remote hosts (Dozzle root URL; with a multi-host
# Dozzle hub + agents, all hosts can share the hub URL)
# PIAPPS2_DOZZLE_URL=
# SYNOLOGY_DOZZLE_URL=
# DS718_DOZZLE_URL=

# Bearer token for the Prometheus /metrics endpoint
# METRICS_TOKEN=

# API base returned by /api/runtime-config (default: derived from the request)
# PUBLIC_API_BASE=https://containeryard.example.com

# Alert webhook SSRF policy. Link-local/metadata targets are always blocked.
WEBHOOK_ALLOW_PRIVATE=false
# Hostnames allowed regardless of the IP they resolve to (e.g. ntfy.lan)
WEBHOOK_ALLOWED_HOSTS=

# Audit log retention in days
AUDIT_RETENTION_DAYS=180

# Host Logs page (ADMIN-only): which host's local files to read, and where
# nginx / PM2 logs live. Missing directories degrade gracefully to "not available".
# HOSTLOGS_LOCAL_HOST=piapps
# HOSTLOG_NGINX_DIR=/var/log/nginx
# HOSTLOG_NGINX_ACCESS_FILE=container.piapps.dev.access.log
# HOSTLOG_NGINX_ERROR_FILE=container.piapps.dev.error.log
# PM2_LOG_DIR=/home/youruser/.pm2/logs
# PM2_APP_NAME=containeryard-api

# ---------- Optional (Docker Compose & Container Entrypoint) ----------

# Image tag to pull/run (default: latest)
# CY_TAG=4.0.0
# Host bind address and port (default: 127.0.0.1:5008)
# CY_BIND=127.0.0.1
# CY_PORT=5008
# Host GIDs added to the container user for /var/run/docker.sock and /var/log/nginx
# DOCKER_GID=113
# ADM_GID=4
# Set to 1 to skip `prisma db push` and `seed.js` on container startup
# CY_SKIP_DB_PUSH=0
