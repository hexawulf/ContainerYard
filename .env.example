# ContainerYard environment. Validated at startup by server/src/config/env.ts.
# Copy to .env and fill in. Never commit the real .env.

# ---------- Required ----------

# Session signing secret, at least 32 characters:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Redis password (used by docker-compose.yml for the bundled redis container)
# Generate with:  openssl rand -hex 24
REDIS_PASSWORD=change-me-redis-password

# Redis URL for sessions (in docker-compose.yml, this is overridden to connect
# to the bundled redis container; for bare-metal/PM2, point at local Redis)
REDIS_URL=redis://127.0.0.1:6379

# Origins allowed to make credentialed CORS requests (comma-separated)
ALLOWED_ORIGINS=https://containeryard.example.com

# Database: SQLite (absolute path recommended) or PostgreSQL.
# In Docker Compose, this is automatically set to file:/data/app.db.
# SQLite supports users, audit log, bookmarks, saved searches; alerts and
# historical metrics need PostgreSQL.
DATABASE_URL=file:/data/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/containeryard

# Local Docker host identity (default: id="local", name="Local Docker")
# CY_LOCAL_HOST_ID=local
# CY_LOCAL_HOST_NAME=Local Docker

# Remote read-only hosts (cAdvisor + optional Dozzle + optional PiDeck log agent), configured as a JSON array.
# Each entry requires {id, name, cadvisorUrl} and accepts optional dozzleUrl and logs:
#   logs: {"type":"pideck-agent","url":"http://10.0.0.10:5016","tokenEnv":"CY_HOSTLOG_TOKEN_HOST_A","timeoutMs":5000}
# Leave empty or unset if monitoring only the local Docker socket.
# CY_REMOTE_HOSTS=[{"id":"host-a","name":"Host A","cadvisorUrl":"http://10.0.0.10:8080","dozzleUrl":"https://dozzle.example.org","logs":{"type":"pideck-agent","url":"http://10.0.0.10:5016","tokenEnv":"CY_HOSTLOG_TOKEN_HOST_A","timeoutMs":5000}},{"id":"nas-1","name":"NAS 1","cadvisorUrl":"http://10.0.0.20:9818"}]
CY_REMOTE_HOSTS=
# Bearer tokens referenced by CY_REMOTE_HOSTS[].logs.tokenEnv (pattern: ^CY_HOSTLOG_TOKEN_[A-Z0-9_]{1,32}$):
# CY_HOSTLOG_TOKEN_HOST_A=

# First ADMIN user, created on first boot if the User table is empty (password >= 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---------- Optional (Server Runtime) ----------

PORT=5008
NODE_ENV=production
LOG_LEVEL=info
# DOCKER_HOST=unix:///var/run/docker.sock

# Session cookie settings
# COOKIE_NAME=__Secure-cy.sid
# COOKIE_DOMAIN=
# lax is recommended when UI and API share an origin (default: none)
COOKIE_SAMESITE=lax

# Bearer token for the Prometheus /metrics endpoint
# METRICS_TOKEN=

# API base returned by /api/runtime-config (default: derived from the request)
# PUBLIC_API_BASE=https://containeryard.example.com

# Alert webhook SSRF policy. Link-local/metadata targets are always blocked.
WEBHOOK_ALLOW_PRIVATE=false
# Hostnames allowed regardless of the IP they resolve to (e.g. ntfy.lan)
WEBHOOK_ALLOWED_HOSTS=

# Audit log retention in days
AUDIT_RETENTION_DAYS=180

# Host Logs page (ADMIN-only): which host's local files to read (defaults to
# CY_LOCAL_HOST_ID), and where nginx / PM2 logs live. Missing directories
# degrade gracefully to "not available".
# HOSTLOGS_LOCAL_HOST=local
# HOSTLOG_NGINX_DIR=/var/log/nginx
# HOSTLOG_NGINX_ACCESS_FILE=access.log
# HOSTLOG_NGINX_ERROR_FILE=error.log
# PM2_LOG_DIR=/home/youruser/.pm2/logs
# Comma-separated PM2 app names to expose on the local host (each adds pm2_<app>_out and pm2_<app>_err)
# HOSTLOG_PM2_APPS=
# Expose ContainerYard's own container logs as `cy_app` (on|off, default: on)
# HOSTLOG_SELF_CONTAINER=on
# Legacy single PM2 app name (only used if explicitly set; empty by default)
# PM2_APP_NAME=

# ---------- Optional (Docker Compose & Container Entrypoint) ----------

# Image tag to pull/run (default: latest)
# CY_TAG=4.0.0
# Host bind address and port (default: 127.0.0.1:5008)
# CY_BIND=127.0.0.1
# CY_PORT=5008
# Host GIDs added to the container user for /var/run/docker.sock and /var/log/nginx
# DOCKER_GID=113
# ADM_GID=4
# Set to 1 to skip `prisma db push` and `seed.js` on container startup
# CY_SKIP_DB_PUSH=0

# ---------- Optional (Google Firebase Authentication) ----------
# Enable "Sign in with Google" via Firebase Auth (verified server-side with firebase-admin).
# Email + password login stays enabled as a break-glass fallback.
# Every allowed email must also have a matching ContainerYard User row (roles come from DB).
# FIREBASE_ENABLED=false
# FIREBASE_PROJECT_ID=containeryard-prod
# FIREBASE_ALLOWED_EMAILS=you@example.com
# Service-account credentials (choose one; in Docker use FIREBASE_SA_HOST_PATH with
# deploy/firebase/docker-compose.firebase.yml, which mounts the file read-only at
# /run/secrets/firebase-sa.json and sets FIREBASE_SERVICE_ACCOUNT_PATH inside the container):
# FIREBASE_SA_HOST_PATH=/home/youruser/.config/containeryard/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Public web-app config (from Firebase Console -> Project settings -> Web app):
# FIREBASE_CLIENT_API_KEY=your-firebase-web-api-key
# FIREBASE_CLIENT_AUTH_DOMAIN=containeryard-prod.firebaseapp.com
# FIREBASE_CLIENT_APP_ID=1:000000000000:web:0000000000000000000000
