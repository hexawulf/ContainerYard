{
  "name": "rest-express",
  "version": "5.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx -r dotenv/config server/index.ts",
    "build": "npm run build:server && npm run build:client && npm run verify:dist",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; import { fileURLToPath } from 'url'; import { dirname } from 'path'; const require = createRequire(import.meta.url); const __filename = fileURLToPath(import.meta.url); const __dirname = dirname(__filename);\"",
    "build:client": "vite build",
    "verify:dist": "bash scripts/verify-dist.sh",
    "start:static": "serve -s dist/public -l tcp://127.0.0.1:5001",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "e2e": "playwright test",
    "e2e:run": "start-server-and-test preview:e2e http://127.0.0.1:4173 \"pnpm e2e\"",
    "start": "NODE_ENV=production node -r dotenv/config dist/index.js",
    "check": "tsc",
    "check:tests": "tsc -p server/tests/tsconfig.json",
    "test:unit": "node --import tsx --test server/tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test server/tests/integration/*.test.ts",
    "test": "npm run test:unit",
    "db:push:prisma": "prisma db push --skip-generate",
    "lint": "eslint . --ext .ts,.tsx",
    "db:push": "drizzle-kit push",
    "deploy:static": "scripts/deploy-static.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dockerode": "^5.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "event-stream": "^4.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.6",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@svgr/rollup": "^8.1.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^3.3.44",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "lefthook": "^2.0.0",
    "madge": "^8.0.0",
    "postcss": "^8.4.47",
    "prisma": "^6.17.1",
    "serve": "^14.2.5",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^6.4.0",
    "wait-on": "^9.0.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "overrides": {
    "qs": "^6.16.2",
    "@prisma/config": {
      "deepmerge-ts": "8.0.1"
    }
  }
}
