{
  "name": "containeryard",
  "version": "6.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx -r dotenv/config server/index.ts",
    "build": "npm run build:server && npm run build:client && npm run verify:dist",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; import { fileURLToPath } from 'url'; import { dirname } from 'path'; const require = createRequire(import.meta.url); const __filename = fileURLToPath(import.meta.url); const __dirname = dirname(__filename);\"",
    "build:client": "vite build",
    "verify:dist": "bash scripts/verify-dist.sh",
    "e2e": "playwright test",
    "test:e2e:ci": "playwright test e2e/theme.spec.ts e2e/hostlogs-switcher.spec.ts e2e/header-actions.spec.ts",
    "start": "NODE_ENV=production node -r dotenv/config dist/index.js",
    "check": "tsc",
    "check:tests": "tsc -p server/tests/tsconfig.json && tsc -p client/tests/tsconfig.json",
    "test:unit": "node --import tsx --test server/tests/unit/*.test.ts client/tests/unit/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude='**/tests/**' --test-coverage-exclude='node_modules/**' server/tests/unit/*.test.ts client/tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test server/tests/integration/*.test.ts",
    "test": "npm run test:unit",
    "db:push:prisma": "prisma db push --skip-generate",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "connect-redis": "^11.0.0",
    "dockerode": "^5.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/app": "^0.16.7",
    "@firebase/auth": "^1.13.11",
    "@playwright/test": "^1.56.1",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "lucide-react": "^1.77.0",
    "madge": "^8.0.0",
    "postcss": "^8.4.47",
    "prisma": "^6.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vite": "^8.4.0",
    "wouter": "^3.3.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "qs": "^6.16.2",
    "@prisma/config": {
      "deepmerge-ts": "8.0.1",
      "effect": "3.22.5"
    }
  }
}
