# Piapps production environment template for ContainerYard (Docker Compose)
# Copy to /home/zk/projects/ContainerYard/.env and populate real secret values.
# NEVER commit real secrets to git.

# ---------- Required ----------
SESSION_SECRET=
REDIS_PASSWORD=
ALLOWED_ORIGINS=https://containeryard.org,https://container.piapps.dev
DATABASE_URL=file:/data/app.db
PIAPPS2_CADVISOR_URL=
SYNOLOGY_CADVISOR_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Optional ----------
PORT=5008
NODE_ENV=production
COOKIE_NAME=__Secure-cy.sid
COOKIE_SAMESITE=lax
PIAPPS2_DOZZLE_URL=
SYNOLOGY_DOZZLE_URL=
# brixhouse DS718+ via piapps4 relay (cadvisor-fwd-ds718.service)
DS718_CADVISOR_URL=http://10.77.0.4:9819
DS718_DOZZLE_URL=
METRICS_TOKEN=
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
AUDIT_RETENTION_DAYS=180

# ---------- Piapps Host Logs & Compose ----------
CY_TAG=4.0.0
CY_BIND=127.0.0.1
CY_PORT=5008
DOCKER_GID=113
ADM_GID=4
HOSTLOGS_LOCAL_HOST=piapps
HOSTLOG_NGINX_DIR=/host/nginx
HOSTLOG_NGINX_ACCESS_FILE=container.piapps.dev.access.log
HOSTLOG_NGINX_ERROR_FILE=container.piapps.dev.error.log
PM2_LOG_DIR=/host/pm2
PM2_APP_NAME=containeryard-api
