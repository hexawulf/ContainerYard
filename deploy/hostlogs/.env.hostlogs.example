# Production environment template with host-log overlay for ContainerYard (Docker Compose)
# Copy to .env and populate real secret values.
# NEVER commit real secrets to git.

# ---------- Required ----------
SESSION_SECRET=
REDIS_PASSWORD=
ALLOWED_ORIGINS=https://containeryard.example.com
DATABASE_URL=file:/data/app.db
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Hosts ----------
CY_LOCAL_HOST_ID=local
CY_LOCAL_HOST_NAME=Local Docker
# JSON array of remote cAdvisor-only hosts:
# CY_REMOTE_HOSTS=[{"id":"edge-01","name":"Edge 01","cadvisorUrl":"http://cadvisor.example.internal:8080","dozzleUrl":"https://dozzle.example.internal"}]
CY_REMOTE_HOSTS=

# ---------- Optional ----------
PORT=5008
NODE_ENV=production
COOKIE_NAME=__Secure-cy.sid
COOKIE_SAMESITE=lax
METRICS_TOKEN=
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
AUDIT_RETENTION_DAYS=180

# ---------- Host Logs & Compose ----------
CY_TAG=5.0.0
CY_BIND=127.0.0.1
CY_PORT=5008
DOCKER_GID=113
ADM_GID=4
HOSTLOGS_LOCAL_HOST=local
HOSTLOG_NGINX_DIR=/host/nginx
HOSTLOG_NGINX_ACCESS_FILE=access.log
HOSTLOG_NGINX_ERROR_FILE=error.log
PM2_LOG_DIR=/host/pm2
PM2_APP_NAME=containeryard-api
