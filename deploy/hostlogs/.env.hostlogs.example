# Production environment template with host-log overlay for ContainerYard (Docker Compose)
# Copy to .env and populate real secret values.
# NEVER commit real secrets to git.

# ---------- Required ----------
SESSION_SECRET=
REDIS_PASSWORD=
ALLOWED_ORIGINS=https://containeryard.example.com
DATABASE_URL=file:/data/app.db
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Hosts ----------
CY_LOCAL_HOST_ID=local
CY_LOCAL_HOST_NAME=Local Docker
# JSON array of remote cAdvisor-only hosts (optional `logs` for read-only PiDeck agents):
# CY_REMOTE_HOSTS=[{"id":"host-a","name":"Host A","cadvisorUrl":"http://10.0.0.10:8080","dozzleUrl":"https://dozzle.example.org","logs":{"type":"pideck-agent","url":"http://10.0.0.10:5016","tokenEnv":"CY_HOSTLOG_TOKEN_HOST_A","timeoutMs":5000}}]
CY_REMOTE_HOSTS=
# Bearer token referenced by `logs.tokenEnv` (must match ^CY_HOSTLOG_TOKEN_[A-Z0-9_]{1,32}$):
# CY_HOSTLOG_TOKEN_HOST_A=

# ---------- Optional ----------
PORT=5008
NODE_ENV=production
COOKIE_NAME=__Secure-cy.sid
COOKIE_SAMESITE=lax
METRICS_TOKEN=
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
AUDIT_RETENTION_DAYS=180

# ---------- Host Logs & Compose ----------
CY_TAG=5.0.0
CY_BIND=127.0.0.1
CY_PORT=5008
DOCKER_GID=113
ADM_GID=4
HOSTLOGS_LOCAL_HOST=local
HOSTLOG_NGINX_DIR=/host/nginx
HOSTLOG_NGINX_ACCESS_FILE=access.log
HOSTLOG_NGINX_ERROR_FILE=error.log
PM2_LOG_DIR=/host/pm2
# Comma-separated PM2 app names to expose on the local host (each yields pm2_<app>_out and pm2_<app>_err)
HOSTLOG_PM2_APPS=
# Expose ContainerYard's own Docker container logs as `cy_app` (on|off, default: on)
HOSTLOG_SELF_CONTAINER=on
# Legacy single PM2 app name (kept only for backwards compatibility if explicitly set)
# PM2_APP_NAME=
