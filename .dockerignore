# Git & version control
.git
.github
.gitignore

# Dependencies & build output
node_modules
dist

# Environment & secrets (never include in image context)
.env
.env.*
!.env.example

# Databases & backups
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite-*

# Logs & runtime state
*.log
logs
.pm2

# Docs, screenshots, assets, scripts & tests (not needed to build or run the app)
docs
deploy
scripts/*
!scripts/verify-dist.sh
e2e
screenshots
attached_assets
server/tests
coverage
playwright-report
test-results
*.md

# Worktrees & editor clutter
ContainerYard-*
.DS_Store
.vscode
.idea
