generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  role           Role     @default(VIEWER)
  totpSecret     String?
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  ADMIN
  VIEWER
}

/// State-changing operations: container/stack actions, logins (v3.1.0)
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String?
  userEmail String?
  action    String
  outcome   String
  hostId    String?
  target    String?
  detail    String?
  ip        String?

  @@index([createdAt])
  @@index([action])
}

/// Per-user "Log Moment" bookmarks (v3.1.0)
model LogBookmark {
  id          Int      @id @default(autoincrement())
  userId      String
  containerId String
  timestamp   String
  note        String?
  filters     String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// Per-user saved log searches (v3.1.1)
model SavedSearch {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  description String?
  query       String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
